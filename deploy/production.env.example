ENVIRONMENT=production
STATE_DATABASE_PATH=/var/lib/codestra/provisioning.db
SQLITE_BACKUP_METADATA_FILE=/run/provisioning-backup-status/latest.json
JWT_ISSUER=https://auth.codestra.co/realms/codestra
JWT_JWKS_URL=https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs
JWT_AUDIENCE=codestra-provisioning-service
JWT_EXPECTED_AZP=REQUIRED_PRODUCTION_CLIENT_ID
JWT_ALLOWED_CLIENTS=REQUIRED_PRODUCTION_CLIENT_ID
JWT_REQUIRED_SCOPES=identity:rotate provisioning:execute provisioning:read
JWT_MAX_TOKEN_TTL_SECONDS=300
JWT_ALGORITHMS=RS256
ADAPTER_CONFIG_FILE=/run/provisioning-secrets/adapter_config.json
CREDENTIAL_ENCRYPTION_KEY_FILE=/run/provisioning-secrets/credential_encryption_key
ODOO_CALLBACK_HMAC_SECRET_FILE=/run/provisioning-secrets/odoo_callback_hmac
ODOO_CALLBACK_CA_FILE=/run/provisioning-secrets/ca.crt
TLS_CERT_FILE=/run/provisioning-secrets/server.crt
TLS_KEY_FILE=/run/provisioning-secrets/server.key
TURN_SHARED_SECRET_FILE=/run/provisioning-secrets/turn_shared_secret
PROVISIONING_SERVICE_GATE=enabled
SERVICE_AUTHENTICATION_GATE=enabled
SERVICE_AUTHORIZATION_GATE=enabled
STEP_ENGINE_GATE=enabled
RETRY_GATE=enabled
DEAD_LETTER_GATE=enabled
CALLBACK_GATE=enabled
RECONCILIATION_GATE=enabled
SECRET_STORAGE_GATE=enabled
RESTART_RECOVERY_GATE=enabled
READINESS_TIMEOUT_SECONDS=3
READINESS_CACHE_SECONDS=15
SIP_BROWSER_CAMPAIGN=TEST_SYN
SIP_BROWSER_ENDPOINT=6101
