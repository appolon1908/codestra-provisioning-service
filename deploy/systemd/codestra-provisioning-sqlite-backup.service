[Unit]
Description=Codestra provisioning encrypted SQLite online backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/codestra/provisioning-sqlite-backup.env
ExecStart=/usr/bin/docker run --rm --name codestra-provisioning-sqlite-backup --network none --read-only --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 64 --memory 256m --cpus 0.5 --entrypoint /opt/venv/bin/python -v codestra-provisioning-production_state:/state:ro -v /etc/codestra/secrets/provisioning-service-production/sqlite_backup_key:/run/secrets/sqlite_backup_key:ro -v /var/backups/codestra/provisioning:/backups:rw ${PROVISIONING_IMAGE} /app/scripts/sqlite_lifecycle.py backup --database /state/provisioning.db --destination /backups --key-file /run/secrets/sqlite_backup_key --retention-days 30
TimeoutStartSec=15m
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/codestra/provisioning /var/run/docker.sock
