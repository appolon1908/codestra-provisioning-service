[Unit]
Description=Codestra provisioning isolated SQLite restore rehearsal
After=docker.service codestra-provisioning-sqlite-backup.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/codestra/provisioning-sqlite-backup.env
ExecStart=/usr/bin/bash /usr/local/sbin/codestra-provisioning-sqlite-restore-rehearsal
TimeoutStartSec=15m
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/backups/codestra/provisioning /etc/codestra/secrets/provisioning-service-production
ReadWritePaths=/var/run/docker.sock
